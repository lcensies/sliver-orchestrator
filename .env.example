# Copy to .env and edit for VM / off-host victims. Container-only use needs nothing.

# Address victims beacon back to. Default = the C2 container's compose IP, which
# only container victims can reach. For VMs / bare-metal victims, set this to the
# Docker host's LAN IP (something the VM can route to).
C2_HOST=172.20.0.10

# Host port the Sliver HTTP C2 listener is published on (host:container are kept
# equal). Implants beacon to C2_HOST:<this>. Default 80; if 80 is taken on the
# host, set another port here and fetch implants with ?port=<this>.
SLIVER_C2_PORT=80

# Bind addresses for published ports. Default 0.0.0.0 (reachable by VMs). Set to
# 127.0.0.1 to keep a port host-local only.
# REST_BIND=0.0.0.0
# GRPC_BIND=0.0.0.0
# SLIVER_C2_BIND=0.0.0.0
# FRONTEND_BIND=0.0.0.0
